# .env.example — 복사해서 .env로 저장한 뒤 값을 채운다. (.env는 커밋하지 않는다)
# 테스트(pytest)는 실제 LLM을 호출하지 않으므로 키 없이도 돈다. 키는 Phase 3 scorer 평가·Phase 5 E2E부터 필요하다.

# ── AWS 인증: 아래 A 또는 B 중 하나만 채운다 ─────────────────────────
# A. 액세스 키 방식
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 임시 자격 증명(STS/SSO)일 때만
AWS_SESSION_TOKEN=

# B. 로컬 AWS 프로필 방식 (~/.aws/credentials 또는 aws sso login)
AWS_PROFILE=

# Bedrock 호출 리전 (global. inference profile을 지원하는 리전)
AWS_REGION=us-east-1

# ── 모델 (비우면 기본값 사용) ───────────────────────────────────────
MODEL_PRIMARY=global.anthropic.claude-sonnet-4-5-20250929-v1:0
# 쉼표로 구분한 폴백 목록 (앞에서부터 순서대로 시도)
MODEL_FALLBACKS=global.anthropic.claude-haiku-4-5-20251001-v1:0
# 모델당 재시도 횟수
LLM_MAX_RETRIES=2

# ── 경로 (상대 경로는 프로젝트 루트 기준) ──────────────────────────
SURVEY_FILE=opic_survey.md
HISTORY_DIR=data/history

# ── 로깅 (DEBUG / INFO / WARNING / ERROR) ─────────────────────────
LOG_LEVEL=INFO
