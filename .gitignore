# 비밀 정보
.env
.env.*
!.env.example

# 실행 산출물 (폴더 구조는 .gitkeep으로 유지)
data/history/*
!data/history/.gitkeep
logs/*
!logs/.gitkeep
evals/results/*
!evals/results/.gitkeep

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Streamlit
.streamlit/secrets.toml

# OS / 에디터
.DS_Store
Thumbs.db
.vscode/
.idea/
